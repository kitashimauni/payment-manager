# Copy to .env.docker, set owner-only permissions (chmod 600), and replace
# these example values before real deployment. Never commit .env.docker.
APP_IMAGE_TAG=local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

POSTGRES_USER=payment_manager
POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_password
POSTGRES_DB=payment_manager
# Must agree with the three POSTGRES_* values above. Host must be 'db'.
# If your password contains URL-reserved characters, percent-encode it here.
DATABASE_URL=postgresql://payment_manager:replace_with_a_long_random_url_safe_password@db:5432/payment_manager

# AUTH_MODE: auto (legacy OAuth if configured), google, local-only, or
# trusted-proxy-single-user (Tailnet-only sync with no login screen).
AUTH_MODE=auto
# In trusted mode: stable random UUID, 32+ random bytes encoded base64url,
# and exact public HTTPS origin (no trailing slash). Generate secrets locally:
#   uuidgen
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'
# Keep token shared ONLY between the app and a trusted same-LXC reverse proxy.
SINGLE_USER_ID=
TRUSTED_PROXY_TOKEN=
TRUSTED_PROXY_ORIGIN=

# Google OAuth requires all three below, DATABASE_URL, AUTH_MODE=google or auto.
# Leave all empty for trusted-proxy-single-user or local-only.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set the public HTTPS origin (e.g. https://payments.example.com) for OAuth.
AUTH_URL=
# Set true ONLY behind a trusted proxy that sanitizes Host/Forwarded headers.
AUTH_TRUST_HOST=false
