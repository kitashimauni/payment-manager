# Used by Drizzle Kit for db:migrate and by the future server-side sync layer.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_manager

# Optional Auth.js + Google OAuth. Leave these blank to keep the app Local Only.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Google OAuth redirect URI: http://localhost:3000/api/auth/callback/google

# CI-only test authentication. Leave blank outside the E2E workflow.
E2E_AUTH_USER_ID=
E2E_AUTH_SECRET=

# Optional PostgreSQL connection used by the integration test suite.
SYNC_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_manager

# Optional Playwright target. Leave blank to use http://localhost:3000.
BASE_URL=
